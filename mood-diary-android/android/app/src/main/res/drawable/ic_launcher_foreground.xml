<!-- Иконка «Дневник настроения».

     Прежняя была стоковым роботом Android — заглушкой из шаблона, какую
     Android Studio кладёт в новый проект. Приложение о ней ничего не
     сообщала.

     Первый вариант новой иконки — скруглённый прямоугольник с сердцем —
     выглядел как смартфон: прямоугольник с тёмной полосой снизу читается как
     телефон, и человек так и называл результат, пока не показал. Сейчас это
     раскрытая книга, а сверху сердце: книга — это дневник, сердце — это
     настроение, и обе детали читаются даже в 32px.

     Плоский рисунок, без градиентов: в монохромной маске Android 13+ система
     берёт только альфу, и градиенты там превращаются в грязь.

     Размер: холст 108×108, как требует adaptive icon. Безопасная зона —
     круг радиусом 36 от центра (54,54); всё, что ближе к краю, маска
     телефона может срезать. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- сердце. Кривые заданы числами, а не <group scale>: порядок, в котором
         Android применяет масштаб и перенос группы, менялся между версиями,
         и иконка рисковала уехать на пару единиц. -->
    <path
        android:fillColor="#F472B6"
        android:pathData="M54,44 C47,38.5 40,33 40,26.5 C40,22.2 43.4,19 47.4,19 C50.2,19 52.6,20.8 54,23.8 C55.4,20.8 57.8,19 60.6,19 C64.6,19 68,22.2 68,26.5 C68,33 61,38.5 54,44 Z" />

    <!-- книга: тёмный слой — это корешок и края страниц, он торчит из-под
         обложки на 3 единицы вниз и вправо -->
    <path
        android:fillColor="#065F46"
        android:pathData="M54,59 C48,52.5 39,49 28,49 L28,76 C39,76 48,80 54,87 C60,80 69,76 80,76 L80,49 C69,49 60,52.5 54,59 Z" />
    <path
        android:fillColor="#10B981"
        android:pathData="M54,56 C48,49.5 39,46 28,46 L28,73 C39,73 48,77 54,84 C60,77 69,73 80,73 L80,46 C69,46 60,49.5 54,56 Z" />
</vector>
<?xml version="1.0" encoding="utf-8"?>
<!-- Иконка для Android 5–7, где adaptive icon ещё не поддерживается. В
     mipmap-anydpi-v26 лежит та же картинка, а без этого файла старые версии
     показывали бы прежнюю png-иконку.

     Слои сложены без отступов, чтобы вектор лёг ровно на весь квадрат: рисунок
     занимает те же 2/3 от края до края, что и в adaptive icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background"/>
    <item android:drawable="@drawable/ic_launcher_foreground"/>
</layer-list>
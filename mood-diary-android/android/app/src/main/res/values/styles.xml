<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <!-- Тёмная принудительно: приложение тёмное по умолчанию, а DayNight на
         светлом телефоне давал белые статус-бар и навигацию. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#10b981</item>
        <item name="colorPrimaryDark">#0a0e1a</item>
        <item name="colorAccent">#10b981</item>
        <item name="android:windowBackground">#0a0e1a</item>
        <item name="android:statusBarColor">#0a0e1a</item>
        <item name="android:navigationBarColor">#0a0e1a</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">#0a0e1a</item>
        <item name="android:navigationBarColor">#0a0e1a</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>